{
  "manifest_version": 3,
  "name": "YT Click-to-Queue & Auto-Playlist",
  "short_name": "Click-to-Queue",
  "version": "1.1.0",
  "description": "Turn on Queue Mode, click any YouTube video to queue it, and keep an automatic dated playlist for every day.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Queue Mode (Alt+Q)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Toggle Queue Mode"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
